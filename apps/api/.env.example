# Copy to .env for local development. No secret belongs in this repository.

REPAIRSCOPE_ENVIRONMENT=development
REPAIRSCOPE_DATABASE_URL=postgresql+asyncpg://repairscope:repairscope@localhost:5432/repairscope

# Clerk development-tenant verification settings. REPAIRSCOPE_CLERK_ISSUER
# is your Clerk application's Frontend API URL (the same domain encoded in
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY — it is not a secret, but there is no
# safe default to ship here since it names your specific Clerk instance).
# Required in any environment where ClerkIdentityVerifier is used.
REPAIRSCOPE_CLERK_ISSUER=

# Comma-separated list of frontend origins allowed to present a token to
# this backend (checked against the token's azp claim when present).
# Required. For local development this is typically http://localhost:3000.
REPAIRSCOPE_CLERK_AUTHORIZED_PARTIES=

# Only set this if your Clerk instance issues tokens with an `aud` claim
# you need enforced. Leave unset for a typical Clerk session-token setup —
# see docs/AUTHORIZATION_MODEL.md for why an unset audience must not reject
# tokens that happen to carry an aud claim.
REPAIRSCOPE_CLERK_AUDIENCE=

# Clock-skew tolerance (seconds) applied to exp/nbf checks, to absorb small
# clock drift between this server and Clerk's infrastructure.
REPAIRSCOPE_CLERK_CLOCK_SKEW_SECONDS=10

# Comma-separated explicit browser origins allowed to call this API
# cross-origin (e.g. from the Next.js frontend). No wildcard is ever
# accepted. Required in production (the app fails to start without it);
# optional in development — leave unset and no CORS middleware is added
# at all (same as before this setting existed). For local development
# against `npm run dev` in apps/web, this is typically
# http://localhost:3000.
REPAIRSCOPE_CORS_ALLOWED_ORIGINS=
