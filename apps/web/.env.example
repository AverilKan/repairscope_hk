# Optional development-only visibility for prototype state selectors.
# Production builds hide these controls regardless of this value.
NEXT_PUBLIC_REPAIRSCOPE_DEMO_MODE=

# Optional canonical URL fallback for metadata when a host header is unavailable.
NEXT_PUBLIC_SITE_URL=https://repairscope.example

# Which RepairScopeServices composition to use. "mock" (default) uses the
# in-memory fixtures; "api" uses the real backend adapter in services/api.ts,
# whose methods currently all throw ApiCapabilityUnavailableError until each
# backend phase lands. An unrecognised value fails fast at startup rather
# than silently falling back to either option.
NEXT_PUBLIC_REPAIRSCOPE_DATA_SOURCE=mock

# Base URL for the RepairScope API adapter. Only read when
# NEXT_PUBLIC_REPAIRSCOPE_DATA_SOURCE=api.
NEXT_PUBLIC_REPAIRSCOPE_API_BASE_URL=http://localhost:8000

# Clerk development-instance keys. Get these from the Clerk dashboard for
# your own development application (Dashboard -> API keys). The publishable
# key is safe to ship to the browser by design; the secret key is not — copy
# both into apps/web/.env.local (not this file, and not tracked by git),
# never into NEXT_PUBLIC_ variables beyond the publishable key itself.
# No value has ever been committed to this repository.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
